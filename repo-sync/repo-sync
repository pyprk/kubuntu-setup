#!/bin/bash
# Keeps every project under /mnt/data/repos committed and pushed to GitHub.
#
#  - a folder with files but no .git is turned into a repo
#  - a repo with no "origin" is created on GitHub (private) and pushed
#  - changes are committed and pushed; if the remote moved, we rebase first
#  - drop a file named .nosync in a folder to leave it alone
#
# Runs from repo-sync.timer every 10 minutes; run "repo-sync" by hand any time.
set -u
ROOT=${REPO_SYNC_ROOT:-/mnt/data/repos}
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/repo-sync.log
mkdir -p "$(dirname "$LOG")" "$ROOT"
exec 9>"$ROOT/.sync.lock"
flock -n 9 || exit 0

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
warn() {
    log "WARN $*"
    notify-send --app-name="repo-sync" --icon=dialog-warning "Repo sync" "$*" 2>/dev/null
}

sync_repo() {
    local dir=$1 name
    name=$(basename "$dir")
    cd "$dir" || return

    if [ ! -d .git ]; then
        [ -n "$(find . -mindepth 1 -maxdepth 1 -not -name '.nosync' -print -quit)" ] || return
        git init -q -b main || { warn "$name: git init failed"; return; }
        log "$name: initialised"
    fi

    if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ]; then
        warn "$name: rebase or merge in progress, skipped"
        return
    fi

    git add -A
    if ! git diff --cached --quiet; then
        git commit -qm "sync: $(date '+%Y-%m-%d %H:%M')" || { warn "$name: commit failed"; return; }
        log "$name: committed"
    fi
    git rev-parse -q --verify HEAD >/dev/null || return   # nothing committed yet

    if ! git remote get-url origin >/dev/null 2>&1; then
        command -v gh >/dev/null || { log "$name: no origin and gh not installed"; return; }
        if gh repo create "$name" --private --source . --remote origin --push >>"$LOG" 2>&1; then
            log "$name: created on GitHub"
        else
            warn "$name: could not create GitHub repo (is gh logged in?)"
        fi
        return
    fi

    local branch
    branch=$(git symbolic-ref -q --short HEAD) || return
    if git push -q -u origin "$branch" 2>>"$LOG"; then
        return
    fi
    if git pull -q --rebase --autostash origin "$branch" 2>>"$LOG" && git push -q -u origin "$branch" 2>>"$LOG"; then
        log "$name: rebased onto remote and pushed"
    else
        warn "$name: push failed, see $LOG"
    fi
}

for dir in "$ROOT"/*/; do
    [ -d "$dir" ] || continue
    [ -e "$dir/.nosync" ] && continue
    ( sync_repo "$dir" )
done
